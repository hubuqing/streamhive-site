{
  "name": "streamhive-site",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": ".output/public"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "streamhive-db",
      "database_id": "YOUR_D1_DATABASE_ID"
    }
  ]
}